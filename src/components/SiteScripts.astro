---
// All page behaviour, ported verbatim from the hand-built HTML and merged into
// one script that is safe on every page (queries are no-ops when a section is
// absent). Kept inline so it runs at end-of-body exactly like the originals.
//   1. reveal-on-scroll (IntersectionObserver) + 4s safety net + reduced-motion
//   2. copy-to-clipboard with toast
//   3. accordion (homepage only)
//   4. nav hide-on-scroll-down / show-on-scroll-up
//   5. solutionHighlight — scroll-linked active item/screen (IntersectionObserver)
---
<script is:inline>
  // 1. Reveal on scroll — content is only hidden once JS confirms the observer.
  (function(){
    var els=[].slice.call(document.querySelectorAll('.reveal,.ink-reveal'));
    function showAll(){els.forEach(function(el){el.classList.add('in');});}
    try{
      if(!('IntersectionObserver' in window)){return;}
      document.documentElement.classList.add('js-reveal');
      var io=new IntersectionObserver(function(entries){
        entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});
      },{threshold:0.08});
      els.forEach(function(el){io.observe(el);});
      setTimeout(showAll,4000);
    }catch(e){showAll();}
  })();

  // 2. Copy to clipboard + toast (email / phone numbers).
  document.querySelectorAll('.copyable').forEach(function(c){
    function copy(){
      if(navigator.clipboard){navigator.clipboard.writeText(c.getAttribute('data-copy'));}
      var t=document.getElementById('toast');
      if(!t){return;}
      t.classList.add('show');setTimeout(function(){t.classList.remove('show');},1600);
    }
    c.addEventListener('click',copy);
    c.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();copy();}});
  });

  // 3. Accordion (present on the homepage only).
  document.querySelectorAll('.acc-item').forEach(function(item){
    item.addEventListener('click',function(){
      var open=item.classList.toggle('open');
      var btn=item.querySelector('.acc-head');
      if(btn){btn.setAttribute('aria-expanded',open?'true':'false');}
    });
  });

  // 4. Nav hides on scroll-down, returns on scroll-up.
  (function(){
    var nav=document.querySelector('nav');
    if(!nav){return;}
    var hero=document.querySelector('.hero');
    var threshold=hero?Math.max(hero.offsetHeight-80,300):400;
    var last=window.pageYOffset;
    window.addEventListener('scroll',function(){
      var y=window.pageYOffset;
      if(y>last && y>threshold){nav.classList.add('nav-hidden');}
      else if(y<last){nav.classList.remove('nav-hidden');}
      last=y;
    },{passive:true});
  })();

  // 5. solutionHighlight — one item/screen is "active" at a time: the screen
  //    whose centre is crossing the viewport's vertical centre. Driven by an
  //    IntersectionObserver whose root is squeezed to a 1px centre line via
  //    rootMargin. DOM writes are batched in rAF; the highlight is visual only,
  //    so nothing here is required for the content to make sense.
  document.querySelectorAll('[data-solhi]').forEach(function(sec){
    var screens=[].slice.call(sec.querySelectorAll('[data-solhi-screen]'));
    var items=[].slice.call(sec.querySelectorAll('[data-solhi-item]'));
    if(!screens.length){return;}

    var active=-1, raf=0;
    function apply(i){
      if(i===active){return;}
      active=i;
      if(raf){return;}
      raf=requestAnimationFrame(function(){
        raf=0;
        screens.forEach(function(el,n){el.classList.toggle('active',n===active);});
        items.forEach(function(el,n){el.classList.toggle('active',n===active);});
      });
    }
    apply(0); // first row lit before any scrolling

    if(!('IntersectionObserver' in window)){return;}
    // Root shrunk to a 1px band at the vertical centre: whatever screen overlaps
    // that band is the active one.
    var io=new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){apply(+e.target.getAttribute('data-index'));}
      });
    },{rootMargin:'-50% 0px -50% 0px',threshold:0});
    screens.forEach(function(el){io.observe(el);});
  });
</script>

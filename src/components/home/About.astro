---
import { site } from '../../data/site.js';
const { cvHref } = site;
---
<section id="about">
  <div class="wrap">
    <div class="sec-head"><span class="label reveal">About</span><a href={cvHref} target="_blank" rel="noopener" class="btn secondary reveal">Download My CV</a></div>
    <div class="about-grid">
      <div class="about-copy reveal">
        <p class="ink-reveal">I'm a <b>UX/UI Product Designer and Researcher</b> who helps mission-driven teams create accessible, user-focused digital experiences, particularly in complex and sensitive contexts where clear design decisions can make a real difference.</p>
        <p class="ink-reveal">My work is grounded in <b>research, empathy, and clarity</b>, with accessibility as a core design principle rather than an afterthought.</p>
      </div>
      <div class="about-photo reveal">
        <img src="https://framerusercontent.com/images/rOyJHMn6bbVVsu1eHxRvRVjpGQ.png" alt="Portrait of the designer in a purple sweater with a dog, surrounded by illustrated hobby icons.">
      </div>
    </div>
  </div>
</section>

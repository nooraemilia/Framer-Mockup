---
import { site } from '../../data/site.js';
const { email, location } = site;
---
<header class="hero">
  <div class="wrap">
    <div class="hero-top">
      <div class="hero-name"><h1>NOORA<span class="emilia">EMILIA</span></h1><h1>SAARELAINEN</h1></div>
      <div class="portrait">
        <img src="https://framerusercontent.com/images/bBNVJpPsXgyw31sQ2qN4IVQ7PDk.png"
             alt="Black-and-white portrait of the designer on a yellow background, facing forward, wearing a dark blazer.">
      </div>
    </div>
    <div class="hero-lower">
      <div class="contact-list">
        <div class="contact-row">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="m3.5 7 8.5 6 8.5-6"/></svg>
          <span class="copyable" data-copy={email} role="button" tabindex="0">{email}</span>
        </div>
        <div class="contact-row">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 21s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12z"/><circle cx="12" cy="9" r="2.4"/></svg>
          <span>{location}</span>
        </div>
        <a href="#contact" class="btn">Let's talk!</a>
      </div>
      <div class="hero-intro">
        <p class="positioning">UX/UI Product Designer &amp; Researcher blending curiosity, empathy,
          and research into accessible experiences that make the complex feel like a no-brainer.</p>
        <a href="#about" class="btn secondary">About me</a>
      </div>
    </div>
  </div>
</header>

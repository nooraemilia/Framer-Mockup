---
import { accordion } from '../../data/home.js';
---
<section>
  <div class="wrap">
    <div class="sec-head"><span class="label reveal">I can help you with…</span></div>
    <div class="accordion reveal">
      {accordion.map((item) => (
        <div class="acc-item">
          <button class="acc-head" aria-expanded="false"><h6>{item.heading}</h6><span class="acc-icon" aria-hidden="true"></span></button>
          <div class="acc-body"><div class="acc-inner">
            <p>{item.intro}</p>
            <p class="kf">Key focus:</p>
            <ul>{item.bullets.map((b) => <li>{b}</li>)}</ul>
          </div></div>
        </div>
      ))}
    </div>
  </div>
</section>

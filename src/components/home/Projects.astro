---
import { projects } from '../../data/home.js';
---
<section id="projects">
  <div class="wrap">
    <div class="sec-head"><span class="label reveal">Projects</span><a href="#" class="btn secondary reveal">Show All</a></div>
    <div class="projects">
      {projects.map((p) => (
        <a class="card reveal" href={p.href}>
          <div class="mock"><img src={p.image.src} alt={p.image.alt}></div>
          <h4>{p.title}</h4>
          <p class="blurb">{p.blurb}</p>
          <div class="tags">{p.tags.map((t) => <span class="tag">{t}</span>)}</div>
        </a>
      ))}
    </div>
  </div>
</section>

---
import { work, education } from '../../data/home.js';

// Hand-drawn arrow SVGs, ported verbatim. Two variants each, alternating by
// index (even → A, odd → B) exactly as in the original index.html.
const workArrows = [
  '<svg class="arw" viewBox="0 0 46 88" aria-hidden="true"><path d="M23 88 C18 70 33 64 24 46 C18 34 27 24 22 10"/><path d="M22 10 C18 19 13 22 8 24"/><path d="M22 10 C27 17 32 20 37 20"/></svg>',
  '<svg class="arw" viewBox="0 0 46 88" aria-hidden="true"><path d="M14 88 C6 74 8 60 18 62 C27 64 22 46 26 32 C28 22 24 16 27 9"/><path d="M27 9 C21 13 17 16 13 17"/><path d="M27 9 C31 16 33 20 34 25"/></svg>',
];
const eduArrows = [
  '<svg class="arw arw-d" viewBox="0 0 46 88" aria-hidden="true"><path d="M23 0 C28 18 13 24 22 42 C28 54 19 66 24 80"/><path d="M24 80 C19 71 14 68 9 67"/><path d="M24 80 C29 71 34 69 39 68"/></svg>',
  '<svg class="arw arw-d" viewBox="0 0 46 88" aria-hidden="true"><path d="M32 0 C40 12 38 28 27 26 C18 24 22 42 19 54 C17 64 20 72 17 80"/><path d="M17 80 C12 72 9 70 5 69"/><path d="M17 80 C22 72 25 70 28 70"/></svg>',
];
const nbsp = ' ';
---
<section>
  <div class="wrap">
    <div class="sec-head"><span class="label reveal">Education &amp; work journey</span></div>
    <div class="journey reveal">
      <div class="tl-wrap">
        <p class="tl-cap">Work experience</p>
        <ol class="tl-row tl-work" aria-label="Work experience, earliest to latest">
          {work.map((e, i) => (
            <li class="entry">
              <div class="date">{e.date}</div>
              <div class="role">{e.role}</div>
              <div class="org">{e.org && e.org.trim() ? e.org : nbsp}</div>
              <Fragment set:html={workArrows[i % 2]} />
            </li>
          ))}
        </ol>
        <div class="tl-line" aria-hidden="true"></div>
        <p class="tl-cap tl-cap-edu">Education</p>
        <ol class="tl-row tl-edu" aria-label="Education, earliest to latest">
          {education.map((e, i) => (
            <li class="entry">
              <Fragment set:html={eduArrows[i % 2]} />
              <div class="date">{e.date}</div>
              <div class="role">{e.role}</div>
              <div class="org">{e.org && e.org.trim() ? e.org : nbsp}</div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

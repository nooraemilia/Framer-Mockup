---
// Shared inverted footer (no paper texture). Identical on home + case pages.
import { site } from '../data/site.js';
const { footerCta, phones, email, socials } = site;
---
<footer id="contact">
  <div class="wrap">
    <p class="foot-cta">{footerCta}</p>
    <div class="socials">
      <a href={socials.whatsapp} target="_blank" rel="noopener" aria-label="WhatsApp"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.6 6.3A7.9 7.9 0 0 0 12 4a8 8 0 0 0-6.9 12l-1 3.7 3.8-1a8 8 0 0 0 3.8 1h.3A8 8 0 0 0 17.6 6.3zM12 18.5a6.6 6.6 0 0 1-3.4-.9l-.24-.15-2.5.66.67-2.44-.16-.25A6.6 6.6 0 1 1 12 18.5zm3.6-4.95c-.2-.1-1.17-.58-1.35-.64s-.31-.1-.44.1-.51.64-.62.77-.23.15-.43.05a5.4 5.4 0 0 1-1.6-1 6 6 0 0 1-1.1-1.37c-.11-.2 0-.3.09-.4l.3-.35a1.35 1.35 0 0 0 .2-.33.37.37 0 0 0 0-.35c0-.1-.44-1.06-.6-1.45s-.32-.33-.44-.34h-.38a.72.72 0 0 0-.52.24 2.2 2.2 0 0 0-.68 1.63A3.8 3.8 0 0 0 8.1 12a8.7 8.7 0 0 0 3.3 2.9c.46.2.82.32 1.1.41.46.15.88.13 1.21.08.37-.05 1.17-.48 1.33-.94s.17-.85.12-.94-.16-.15-.36-.25z"/></svg></a>
      <a href={socials.instagram} target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none"/></svg></a>
      <a href={socials.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4 0 4.75 2.4 4.75 5.5V21H21v-5.5c0-1.3-.02-3-1.85-3-1.85 0-2.15 1.44-2.15 2.9V21H13z"/></svg></a>
      <a href={socials.medium} target="_blank" rel="noopener" aria-label="Medium"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><ellipse cx="6.4" cy="12" rx="5.4" ry="5"/><ellipse cx="16" cy="12" rx="2.4" ry="4.6"/><ellipse cx="21.3" cy="12" rx="1" ry="4.2"/></svg></a>
    </div>
    <div class="foot-bottom">
      <div class="foot-contact">
        {phones.map((p) => <span class="copyable" data-copy={p} role="button" tabindex="0">{p}</span>)}
        <span class="copyable" data-copy={email} role="button" tabindex="0">{email}</span>
      </div>
      <div class="foot-rights">All rights reserved,<br>NOORA EMILIA 2026</div>
    </div>
  </div>
</footer>

<div id="toast">Copied to clipboard</div>
